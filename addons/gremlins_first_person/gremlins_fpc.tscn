script/source = "extends Damageable

@onready var pickup_prompt_label: Label = $CanvasLayer/PickupPrompt

# --- Movement Settings ---
@export var speed : float = 5
@export var sprint_speed : float = 8
@export var crouched_speed : float = 3
@export var jump_force : float = 7
@export var friction : float = 10
@export var air_movement : bool = false

# --- Mouse Settings ---
@export var sensitivity : float = 0.005

# --- Sprint/Crouch ---
@export var toggleable_sprint : bool = false
@export var toggleable_crouch : bool = false
@export var crouch_easing : float = 0.3
@export var crouch_deepness : float = 1

# --- Shooting ---
@export var weapon_damage : float = 25
@export var impact_scene : PackedScene   # optional, for muzzle flash / impact effects

# --- Camera Bobbing & Leaning ---
@export var bobbing_enabled: bool = true
@export var bobbing_speed: float = 14.0
@export var bobbing_intensity: float = 0.08
@export var bobbing_horizontal_intensity: float = 0.04
@export var leaning_enabled: bool = true
@export var leaning_intensity: float = 0.05
@export var leaning_smoothing: float = 8.0

# --- FOV Settings ---
@export var normal_fov: float = 75.0
@export var sprint_fov: float = 90.0
@export var fov_smoothing: float = 6.0

# --- Input Names ---
@export_group(\"Inputs\")
@export var left : String = \"left\"
@export var right : String = \"right\"
@export var forward : String = \"forward\"
@export var backward : String = \"backward\"
@export var sprint : String = \"sprint\"
@export var jump : String = \"jump\"
@export var crouch : String = \"crouch\"

# --- Nodes ---
@onready var head = $Head
@onready var camera = $Head/Camera
@onready var health_bar: ProgressBar = $CanvasLayer/HealthBar
@onready var damage_flash: ColorRect = $CanvasLayer/DamageFlash
@onready var ammo_label: Label = $CanvasLayer/AmmoLabel
@onready var soul_label: Label = $CanvasLayer/SoulLabel

# --- State ---
var is_sprinting : bool = false
var is_crouching : bool = false
var head_original_height : float
var flash_duration := 0.2
var flash_timer := 0.0

# Ammo & Souls
var ammo_pistol: int = 30
var max_ammo_pistol: int = 100
var soul_count: int = 0

# Pickup system (for 3D prompts)
var current_near_pickup = null

# Camera bobbing / leaning state
var bobbing_time: float = 0.0
var target_lean: float = 0.0
var current_lean: float = 0.0

# Camera shake state
var shake_remaining: float = 0.0
var shake_intensity: float = 0.0

@onready var audio_stream_player: AudioStreamPlayer = $AudioStreamPlayer

func _ready():
	Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
	head_original_height = head.position.y
	health = max_health
	
	set_process_input(true)
	set_process_unhandled_input(true)
	
	damage_flash.mouse_filter = Control.MOUSE_FILTER_IGNORE
	health_bar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	
	#update_health_color(health_bar, health / max_health)
	#update_ammo_ui()
	#update_soul_ui()
	
	camera.fov = normal_fov
	
	# Connect signals for 3D pickups (optional, if you still use EventBus)
	EventBus.show_pickup_prompt.connect(_on_show_pickup_prompt)
	EventBus.hide_pickup_prompt.connect(_on_hide_pickup_prompt)
	EventBus.player_health_changed.emit(health, max_health)
	EventBus.player_ammo_changed.emit(ammo_pistol)
	EventBus.player_soul_changed.emit(soul_count)

func _process(delta: float):
	if flash_timer > 0:
		flash_timer -= delta
		damage_flash.color = Color(1, 0, 0, flash_timer / flash_duration)
	else:
		damage_flash.color = Color(1, 0, 0, 0)
	
	update_camera_motion(delta)

# -------------------------
# INPUT HANDLING
# -------------------------
func _input(event):
	if Input.is_action_just_pressed(\"ui_cancel\"):
		Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)

	if event is InputEventMouseButton:
		if event.pressed:
			Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)

	# Sprint
	if toggleable_sprint:
		if Input.is_action_just_pressed(sprint):
			is_sprinting = !is_sprinting
	else:
		is_sprinting = Input.is_action_pressed(sprint)

	# Crouch
	if toggleable_crouch:
		if Input.is_action_just_pressed(crouch):
			if is_crouching:
				_uncrouch()
			else:
				_crouch()
	else:
		if Input.is_action_just_pressed(crouch):
			_crouch()
		elif Input.is_action_just_released(crouch):
			_uncrouch()
			
	if event.is_action_pressed(\"fire\"):
		shoot()
	
	if event.is_action_pressed(\"interact\") and current_near_pickup:
		current_near_pickup.pickup(self)
		current_near_pickup = null
		_on_hide_pickup_prompt()

# -------------------------
# MOUSE LOOK
# -------------------------
func _unhandled_input(event):
	if event is InputEventMouseMotion:
		head.rotate_y(-event.relative.x * sensitivity)
		camera.rotate_x(-event.relative.y * sensitivity)
		camera.rotation.x = clamp(camera.rotation.x, deg_to_rad(-80), deg_to_rad(80))

# -------------------------
# MOVEMENT
# -------------------------
func _physics_process(delta: float):
	apply_gravity(delta)
	
	if Input.is_action_just_pressed(jump) and is_on_floor():
		velocity.y = jump_force

	var input_dir := Input.get_vector(left, right, forward, backward)
	var direction = (head.transform.basis * Vector3(input_dir.x, 0, input_dir.y)).normalized()

	if direction:
		if air_movement or is_on_floor():
			_set_speed(direction)
	else:
		velocity.x = move_toward(velocity.x, 0, friction)
		velocity.z = move_toward(velocity.z, 0, friction)

	if EventBus.canMove:
		move_character()

# -------------------------
# SPEED CONTROL
# -------------------------
func _set_speed(dir):
	var move_speed : float
	if is_crouching:
		move_speed = crouched_speed
	elif is_sprinting:
		move_speed = sprint_speed
	else:
		move_speed = speed

	velocity.x = dir.x * move_speed
	velocity.z = dir.z * move_speed

# -------------------------
# CROUCH SYSTEM
# -------------------------
func _crouch():
	var target_height = head_original_height - crouch_deepness
	if crouch_easing == 0:
		head.position.y = target_height
	else:
		var tween = create_tween()
		tween.tween_property(head, \"position:y\", target_height, crouch_easing)
	is_crouching = true

func _uncrouch():
	if crouch_easing == 0:
		head.position.y = head_original_height
	else:
		var tween = create_tween()
		tween.tween_property(head, \"position:y\", head_original_height, crouch_easing)
	is_crouching = false

# -------------------------
# CAMERA BOB, LEAN & SHAKE
# -------------------------
func update_camera_motion(delta: float):
	var velocity_horizontal = Vector2(velocity.x, velocity.z).length()
	var is_moving = velocity_horizontal > 0.1 and is_on_floor()
	
	var target_cam_pos = Vector3.ZERO
	if bobbing_enabled and is_moving:
		var current_move_speed = speed
		if is_sprinting:
			current_move_speed = sprint_speed
		elif is_crouching:
			current_move_speed = crouched_speed
		var speed_ratio = clamp(current_move_speed / sprint_speed, 0.4, 1.0)
		bobbing_time += delta * bobbing_speed * speed_ratio
		target_cam_pos.y = sin(bobbing_time) * bobbing_intensity
		target_cam_pos.x = cos(bobbing_time * 0.8) * bobbing_horizontal_intensity
	else:
		bobbing_time = 0.0
		target_cam_pos = Vector3.ZERO
	
	if leaning_enabled and is_moving:
		var input_dir = Input.get_vector(left, right, forward, backward)
		target_lean = -input_dir.x * leaning_intensity
	else:
		target_lean = 0.0
	current_lean = lerp(current_lean, target_lean, delta * leaning_smoothing)
	camera.rotation.z = current_lean
	
	var shake_offset = Vector3.ZERO
	if shake_remaining > 0:
		shake_remaining -= delta
		var current_intensity = shake_intensity * (shake_remaining / (shake_remaining + delta))
		shake_offset.x = randf_range(-current_intensity, current_intensity)
		shake_offset.y = randf_range(-current_intensity * 0.5, current_intensity * 0.5)
		if shake_remaining <= 0:
			shake_remaining = 0
	camera.position = target_cam_pos + shake_offset
	
	# --- FOV CHANGE ---
	var moving = velocity_horizontal > 0.1

	var target_fov = normal_fov

	if is_sprinting and moving and not is_crouching:
		var speed_ratio = clamp( velocity_horizontal / sprint_speed, 0.0, 1.0)
		target_fov = lerp(normal_fov, sprint_fov, speed_ratio)

	camera.fov = lerp(camera.fov, target_fov, delta * fov_smoothing)

func camera_shake(intensity: float = 0.15, duration: float = 0.2):
	shake_remaining = duration
	shake_intensity = intensity

# -------------------------
# SHOOTING (PROJECTILE VERSION)
# -------------------------
func shoot():
	if ammo_pistol <= 0:
		print(\"Out of ammo!\")
		return
	
	ammo_pistol -= 1
	update_ammo_ui()
	
	var projectile_scene = preload(\"res://source/assets/scenes/projectile.tscn\")
	var projectile = projectile_scene.instantiate()
	
	# Add to scene tree FIRST (so get_tree() works)
	get_tree().root.add_child(projectile)
	
	# Position at camera, slightly forward
	var spawn_pos = camera.global_position + camera.global_transform.basis.z * -0.5
	projectile.global_position = spawn_pos
	
	var direction = -camera.global_transform.basis.z
	direction = direction.normalized()
	
	# Initialize (projectile now has a valid tree)
	if projectile.has_method(\"initialize\"):
		projectile.initialize(direction, weapon_damage, self)
	else:
		projectile.linear_velocity = direction * 30.0
	
	audio_stream_player.play()
	camera_shake(0.12, 0.18)
	EventBus.player_ammo_changed.emit(ammo_pistol)
	# Optional muzzle flash
	if impact_scene:
		var flash = impact_scene.instantiate()
		get_tree().root.add_child(flash)
		flash.global_position = spawn_pos
		await get_tree().create_timer(0.1).timeout
		flash.queue_free()
# -------------------------
# PICKUP SYSTEM (for 3D prompts)
# -------------------------
func _on_show_pickup_prompt(prompt_text, pickup_ref):
	current_near_pickup = pickup_ref
	if pickup_prompt_label:
		pickup_prompt_label.text = \"Press E to pick up \" + prompt_text
		pickup_prompt_label.visible = true

func _on_hide_pickup_prompt():
	current_near_pickup = null
	if pickup_prompt_label:
		pickup_prompt_label.visible = false

func add_ammo(amount: int):
	ammo_pistol = min(ammo_pistol + amount, max_ammo_pistol)
	#update_ammo_ui()
	EventBus.player_ammo_changed.emit(ammo_pistol)

func add_soul(amount: int):
	soul_count += amount
	#update_soul_ui()
	print(\"Souls: \", soul_count)
	EventBus.player_soul_changed.emit(soul_count)

func heal(amount: int):
	health = min(health + amount, max_health)
	var ratio = health / max_health
	#update_health_color(health_bar, ratio)
	var tween = create_tween()
	tween.tween_property(health_bar, \"value\", ratio * 100, 0.3)
	EventBus.player_health_changed.emit(health, max_health)

func update_ammo_ui():
	if ammo_label:
		ammo_label.text = str(ammo_pistol)

func update_soul_ui():
	if soul_label:
		soul_label.text = str(soul_count)

# -------------------------
# DAMAGE SYSTEM
# -------------------------
func take_damage(amount):
	super.take_damage(amount)
	flash_timer = flash_duration

	var flash_tween = create_tween()
	flash_tween.tween_property(damage_flash, \"color:a\", 1.0, 0.05)
	flash_tween.tween_property(damage_flash, \"color:a\", 0.0, 0.3)

	var ratio = health / max_health
	var health_tween = create_tween()
	health_tween.tween_property(health_bar, \"value\", ratio * 100, 0.3)
	update_health_color(health_bar, ratio)

	camera_shake(0.2, 0.25)
	print(\"Player Health:\", health)
	EventBus.player_health_changed.emit(health, max_health)

func on_death():
	print(\"Player died\")
	get_tree().reload_current_scene()

func update_health_color(bar: ProgressBar, ratio: float):
	var original_style = bar.get_theme_stylebox(\"fill\")
	var fill_style: StyleBoxFlat
	
	if original_style is StyleBoxFlat:
		fill_style = original_style.duplicate()
	else:
		fill_style = StyleBoxFlat.new()
		fill_style.set_corner_radius_all(4)
		fill_style.set_border_width_all(1)
		fill_style.border_color = Color.WHITE
	
	fill_style.bg_color = get_health_color(ratio)
	bar.add_theme_stylebox_override(\"fill\", fill_style)

func flash_hit():
	pass
"

